<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Doctor App</display-name>
    <description>A web application for managing doctors information</description>

    <!-- Servlets -->
    <servlet>
        <servlet-name>AddMedecinServlet</servlet-name>
        <servlet-class>com.doctor.servlet.AddMedecinServlet</servlet-class>
    </servlet>
    
    <servlet>
        <servlet-name>ListMedecinServlet</servlet-name>
        <servlet-class>com.doctor.servlet.ListMedecinServlet</servlet-class>
    </servlet>
    
    <servlet>
        <servlet-name>DeleteMedecinServlet</servlet-name>
        <servlet-class>com.doctor.servlet.DeleteMedecinServlet</servlet-class>
    </servlet>

    <!-- Servlet Mappings -->
    <servlet-mapping>
        <servlet-name>AddMedecinServlet</servlet-name>
        <url-pattern>/add</url-pattern>
    </servlet-mapping>
    
    <servlet-mapping>
        <servlet-name>ListMedecinServlet</servlet-name>
        <url-pattern>/list</url-pattern>
    </servlet-mapping>
    
    <servlet-mapping>
        <servlet-name>DeleteMedecinServlet</servlet-name>
        <url-pattern>/delete</url-pattern>
    </servlet-mapping>

    <!-- Welcome files -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Session timeout (30 minutes) -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

</web-app>